{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.4.0",
  "description": "__MSG_extDescription__",
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "alarms",
    "declarativeNetRequest",
    "cookies",
    "privacy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/gzblock-16.png",
      "32": "icons/gzblock-32.png",
      "48": "icons/gzblock-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "short_name": "__MSG_extName__",
  "icons": {
    "16": "icons/gzblock-16.png",
    "32": "icons/gzblock-32.png",
    "48": "icons/gzblock-48.png",
    "128": "icons/gzblock-128.png"
  },
  "default_locale": "en"
}